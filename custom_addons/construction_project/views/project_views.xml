<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_construction_job_tree" model="ir.ui.view">
            <name>construction.job.tree</name>
            <model>construction.job</model>
            <arch type="xml">
                <list string="Construction Projects">
                    <field name="project_code"/>
                    <field name="name"/>
                    <field name="manager_id"/>
                    <field name="stage"/>
                </list>
            </arch>
        </record>

        <record id="view_construction_job_form" model="ir.ui.view">
            <name>construction.job.form</name>
            <model>construction.job</model>
            <arch type="xml">
                <form string="Construction Project">
                    <header>
                        <field name="stage" widget="statusbar" statusbar_visible="survey,boq,fabrication,installation,billing,done" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Project Name"/>
                            <h1><field name="name" placeholder="e.g. Cold Storage Facility A"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_code"/>
                            </group>
                            <group>
                                <field name="manager_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Execution Details" name="details">
                                <field name="notes" placeholder="Add specific fabrication or survey requirements..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </arch>
        </record>

        <record id="action_construction_job" model="ir.actions.act_window">
            <name>Construction Projects</name>
            <res_model>construction.job</res_model>
            <view_mode>list,form</view_mode>
        </record>

        <menuitem id="menu_construction_root" name="Construction Ops" web_icon="base,static/description/icon.png" sequence="10"/>
        
        <menuitem id="menu_construction_job" name="Projects Dashboard" parent="menu_construction_root" action="action_construction_job" sequence="10"/>

    </data>
</odoo>
